{
  "name": "gridbrawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --outfile=node_modules/.cache/sim.cjs --log-level=error && node node_modules/.cache/sim.cjs",
    "sim:run": "esbuild scripts/simrun.ts --bundle --platform=node --outfile=node_modules/.cache/simrun.cjs --log-level=error && node node_modules/.cache/simrun.cjs",
    "check": "esbuild scripts/checkhooks.ts --bundle --platform=node --outfile=node_modules/.cache/check.cjs --log-level=error && node node_modules/.cache/check.cjs",
    "sprites": "node scripts/packsprites.mjs",
    "rocks": "node scripts/packrocks.mjs",
    "icon": "node scripts/makeicon.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "firebase": "^12.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.22.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
