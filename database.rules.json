{
  "rules": {
    ".read": false,
    ".write": false,

    "decks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$deckId": {
          ".validate": "newData.hasChildren(['id', 'name', 'charId', 'cardIds'])",
          "id": { ".validate": "newData.isString() && newData.val() === $deckId" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "charId": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "cardIds": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length <= 40" }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "gridbrawl": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{4,8}$/)",
        ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{4,8}$/)",

        "offer": {
          "type": { ".validate": "newData.isString() && newData.val() === 'offer'" },
          "sdp": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        },
        "answer": {
          "type": { ".validate": "newData.isString() && newData.val() === 'answer'" },
          "sdp": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "gridbrawl-mm": {
      ".read": true,

      "$id": {
        ".write": "$id.matches(/^[A-HJ-NP-Z2-9]{4,8}$/)",

        "offer": {
          "type": { ".validate": "newData.isString() && newData.val() === 'offer'" },
          "sdp": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        },
        "answer": {
          "type": { ".validate": "newData.isString() && newData.val() === 'answer'" },
          "sdp": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "aliveAt": { ".validate": "newData.isNumber()" },
        "lock": { ".validate": "newData.isString() && newData.val().length < 40" },
        "$other": { ".validate": false }
      }
    }
  }
}
